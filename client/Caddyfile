{
	admin off
	# The platform edge terminates TLS; this container only ever sees plain
	# HTTP on $PORT, and has no control over the hostname a cert would need.
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd
	file_server

	# Vite content-hashes everything under /assets, so it is safe to cache
	# forever. index.html must not be cached or clients keep the old bundle.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	# SPA history fallback: client-side routes have no file on disk.
	try_files {path} /index.html
}
