ENVIRONMENT=development

# Which upstream addresses uvicorn will trust X-Forwarded-For from. Read by
# uvicorn directly. Without it uvicorn trusts only 127.0.0.1, so behind a
# platform proxy (Railway) request.client.host is the *proxy's* address and
# every caller shares one rate-limit bucket. Set to "*" only where the
# container is reachable exclusively through a trusted proxy — otherwise a
# client can spoof the header and evade per-IP limits.
#FORWARDED_ALLOW_IPS=*
DATABASE_URL=postgresql+asyncpg://distilled:distilled@localhost:5432/distilled
INTERNAL_CRON_SECRET=

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

SEED_TENANT_ID=00000000-0000-0000-0000-000000000001
SEED_TENANT_NAME=dev

CLERK_PUBLISHABLE_KEY=pk_test_<our-clerk-publishable-key>
CLERK_JWKS_URL=https://<our-clerk-subdomain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_<our-clerk-secret-key>
#CLERK_EXPECTED_AUDIENCE=  # optional: set to the custom audience configured in the Clerk dashboard
#CLERK_ISSUER=             # optional: set to the Clerk frontend API URL for issuer validation
#CLERK_SMOKE_USER_ID=      # optional: only needed for smoke tests (seed script)
#CLERK_SMOKE_USER_EMAIL=   # optional: only needed for smoke tests (Playwright sign-in)

EMAIL_BASE_URL=http://localhost:5173
EMAIL_PROVIDER=log # "log" (dev) or "resend" (prod)
RESEND_API_KEY=                   
EMAIL_FROM=hello@distilledmetrics.com
INVITATION_TTL_DAYS=14