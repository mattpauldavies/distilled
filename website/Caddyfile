{
	admin off
	# The platform edge terminates TLS; this container only ever sees plain
	# HTTP on $PORT, and has no control over the hostname a cert would need.
	auto_https off
}

:{$PORT:8080} {
	# SITE_ROOT lets the routing tests point this same config at a local
	# build; the image serves the /srv it copies the build output into.
	root * {$SITE_ROOT:/srv}
	encode gzip zstd
	header Cache-Control "public, max-age=300"

	# Extensionless URLs are canonical: /terms, not /terms.html. The site was
	# previously hosted on Cloudflare Pages, which served every page that way
	# and permanently redirected the .html form to it — those 301s are cached
	# in browsers and indexed by search engines, so /terms has to keep working.
	# Backslashes are excluded from the capture: browsers resolve "\" as "/"
	# in a Location header, so echoing "/\evil.com/x" would be an open
	# redirect off the site. Such paths fall through to try_files and 404.
	@html path_regexp page ^/([^\\]+)\.html$
	@html_query {
		path_regexp page ^/([^\\]+)\.html$
		expression {query} != ""
	}
	redir /index.html / 301
	redir /index / 301
	redir @html_query /{re.page.1}?{query} 301
	redir @html /{re.page.1} 301

	# ...and serve those canonical URLs from the flat .html files the build
	# emits, so the redirects above never land on a 404.
	try_files {path} {path}.html
	file_server

	# Deliberately no SPA fallback — a missing marketing page must 404 rather
	# than render the homepage under a wrong URL and get indexed as one.
	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
